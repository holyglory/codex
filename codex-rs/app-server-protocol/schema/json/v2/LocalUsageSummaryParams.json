{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LocalUsageCursor": {
      "properties": {
        "id": {
          "type": "string"
        },
        "observedAtMs": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "observedAtMs"
      ],
      "type": "object"
    }
  },
  "description": "Read one consistent usage-v2 snapshot. No legacy usage database is opened.",
  "properties": {
    "accountId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "contractVersion": {
      "default": null,
      "description": "Omission selects version 1; unsupported versions are rejected.",
      "format": "uint32",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "expectedSnapshot": {
      "default": null,
      "description": "Required with a continuation, so paging never silently mixes snapshots.",
      "type": [
        "string",
        "null"
      ]
    },
    "fromAtMs": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "includeReview": {
      "default": false,
      "type": "boolean"
    },
    "includeUnassigned": {
      "default": false,
      "description": "Compatibility flag, meaningful only alongside a worktree selector.",
      "type": "boolean"
    },
    "operationLimit": {
      "default": 0,
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "operationsAfter": {
      "anyOf": [
        {
          "$ref": "#/definitions/LocalUsageCursor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recordLimit": {
      "default": 0,
      "description": "Zero/omission excludes detail; a requested page is limited to 50 rows.",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "recordsAfter": {
      "anyOf": [
        {
          "$ref": "#/definitions/LocalUsageCursor"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repositoryId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "toAtMs": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "workstreamId": {
      "default": null,
      "description": "Recognized but currently rejected: outcome rows can be selected by the consumer, while complete workstream-scoped summary vectors are unavailable.",
      "type": [
        "string",
        "null"
      ]
    },
    "worktreeKeys": {
      "default": null,
      "description": "Reserved compatibility selector; non-null is rejected until captured.",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "title": "LocalUsageSummaryParams",
  "type": "object"
}
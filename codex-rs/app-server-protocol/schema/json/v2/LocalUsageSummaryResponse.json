{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "LocalUsageCursor": {
      "properties": {
        "id": {
          "type": "string"
        },
        "observedAtMs": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "observedAtMs"
      ],
      "type": "object"
    },
    "LocalUsageOperationBinding": {
      "properties": {
        "capturedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "operationId": {
          "type": "string"
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "workContextId": {
          "type": "string"
        }
      },
      "required": [
        "capturedAtMs",
        "operationId",
        "schemaVersion",
        "workContextId"
      ],
      "type": "object"
    },
    "LocalUsageSnapshot": {
      "properties": {
        "freshness": {
          "type": "string"
        },
        "generatedAt": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "journalWatermark": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "pendingCorrections": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "pendingEntries": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "refreshId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceWatermark": {
          "type": "string"
        },
        "updatedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "watermark": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "watermarkAtMs": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "freshness",
        "generatedAt",
        "generation",
        "journalWatermark",
        "pendingCorrections",
        "pendingEntries",
        "sourceWatermark",
        "updatedAtMs",
        "watermark",
        "watermarkAtMs"
      ],
      "type": "object"
    },
    "LocalUsageWorkContext": {
      "additionalProperties": false,
      "description": "Only explicitly captured bindings may populate this versioned extension. Repository/thread identity or operation completion never implies a binding.",
      "properties": {
        "experimentRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "nativeProjectId": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcomeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "repositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "schemaVersion": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "workstreamId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "schemaVersion"
      ],
      "type": "object"
    }
  },
  "description": "Content-free summary with opt-in finite diagnostics. `report` preserves the existing localUsage/summary envelope; `summary` is the native usage-v2 view.",
  "properties": {
    "contractVersion": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "generatedAt": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "nextOperationsCursor": {
      "anyOf": [
        {
          "$ref": "#/definitions/LocalUsageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextRecordsCursor": {
      "anyOf": [
        {
          "$ref": "#/definitions/LocalUsageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "items": true,
      "type": [
        "array",
        "null"
      ]
    },
    "operationBindings": {
      "items": {
        "$ref": "#/definitions/LocalUsageOperationBinding"
      },
      "type": "array"
    },
    "operations": {
      "items": true,
      "type": [
        "array",
        "null"
      ]
    },
    "report": true,
    "review": true,
    "snapshot": {
      "$ref": "#/definitions/LocalUsageSnapshot"
    },
    "source": {
      "type": "string"
    },
    "summary": true,
    "workContexts": {
      "items": {
        "$ref": "#/definitions/LocalUsageWorkContext"
      },
      "type": "array"
    }
  },
  "required": [
    "contractVersion",
    "generatedAt",
    "operationBindings",
    "report",
    "snapshot",
    "source",
    "summary",
    "workContexts"
  ],
  "title": "LocalUsageSummaryResponse",
  "type": "object"
}
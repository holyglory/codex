{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProjectAutomation": {
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "delivery": {
          "additionalProperties": {
            "$ref": "#/definitions/ProjectDeliveryObligation"
          },
          "type": "object"
        },
        "lastActivityAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "lastReviewRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/definitions/ProjectAutomationMode"
        },
        "nextReviewAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "ownerThreadId": {
          "type": "string"
        },
        "paused": {
          "type": "boolean"
        },
        "projectId": {
          "type": "string"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectAutomationJob"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewIntervalMs": {
          "format": "int64",
          "type": "integer"
        },
        "reviewWindowStartMs": {
          "format": "int64",
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "threadExperiments": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "threadOutcomes": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "threadWorkstreams": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "threads": {
          "additionalProperties": {
            "$ref": "#/definitions/ProjectWorkPurpose"
          },
          "type": "object"
        }
      },
      "required": [
        "completed",
        "delivery",
        "lastActivityAtMs",
        "mode",
        "nextReviewAtMs",
        "ownerThreadId",
        "paused",
        "projectId",
        "reviewIntervalMs",
        "reviewWindowStartMs",
        "revision",
        "startedAtMs",
        "threadWorkstreams",
        "threads"
      ],
      "type": "object"
    },
    "ProjectAutomationCapability": {
      "properties": {
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "type": "object"
    },
    "ProjectAutomationJob": {
      "properties": {
        "decisionRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "dueAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ProjectAutomationJobKind"
        },
        "notified": {
          "type": "boolean"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "dueAtMs",
        "id",
        "kind",
        "notified",
        "revision"
      ],
      "type": "object"
    },
    "ProjectAutomationJobKind": {
      "enum": [
        "performanceReview",
        "delivery",
        "deliveryRecovery"
      ],
      "type": "string"
    },
    "ProjectAutomationMode": {
      "enum": [
        "performanceOnly",
        "normal",
        "deliveryDue",
        "recoveryOnly",
        "paused"
      ],
      "type": "string"
    },
    "ProjectDeliveryObligation": {
      "properties": {
        "acceptance": {
          "type": "string"
        },
        "deliveredAtMs": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "deliveryDueAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "deliveryIntervalMs": {
          "format": "int64",
          "type": "integer"
        },
        "evidenceRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "hardStopAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "hardStopIntervalMs": {
          "format": "int64",
          "type": "integer"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectAutomationJob"
            },
            {
              "type": "null"
            }
          ]
        },
        "paused": {
          "type": "boolean"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "startedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "surface": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "workstream": {
          "type": "string"
        }
      },
      "required": [
        "acceptance",
        "deliveryDueAtMs",
        "deliveryIntervalMs",
        "hardStopAtMs",
        "hardStopIntervalMs",
        "paused",
        "revision",
        "startedAtMs",
        "surface",
        "target",
        "workstream"
      ],
      "type": "object"
    },
    "ProjectWorkPurpose": {
      "enum": [
        "discussion",
        "specification",
        "analysis",
        "implementation",
        "recovery"
      ],
      "type": "string"
    }
  },
  "properties": {
    "capability": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProjectAutomationCapability"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "anyOf": [
        {
          "$ref": "#/definitions/ProjectAutomation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ProjectAutomationCommandResponse",
  "type": "object"
}
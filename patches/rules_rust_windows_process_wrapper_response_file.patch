+#[cfg(windows)]
+fn rustc_arguments_with_response_file(
+    executable: &str,
+    arguments: &[String],
+) -> Result<(Vec<String>, Option<String>), ProcessWrapperError> {
+    let command_line_length = executable.len()
+        + arguments
+            .iter()
+            .map(|argument| argument.len().saturating_add(3))
+            .sum::<usize>();
+    let is_rustc = executable.ends_with("rustc.exe")
+        || executable.ends_with("rustc")
+        || executable.ends_with("clippy-driver.exe")
+        || executable.ends_with("clippy-driver");
+    if !is_rustc || command_line_length < 30_000 {
+        return Ok((arguments.to_vec(), None));
+    }
+
+    let path = std::env::temp_dir().join(format!(
+        "rules-rust-process-wrapper-{}-{}.rsp",
+        std::process::id(),
+        command_line_length
+    ));
+    let mut file = File::create(&path).map_err(|error| {
+        ProcessWrapperError(format!("failed to create rustc response file: {error}"))
+    })?;
+    for argument in arguments {
+        writeln!(file, "{argument}").map_err(|error| {
+            ProcessWrapperError(format!("failed to write rustc response file: {error}"))
+        })?;
+    }
+    Ok((
+        vec![format!("@{}", path.to_string_lossy())],
+        Some(path.to_string_lossy().into_owned()),
+    ))
+}
+

+#[cfg(all(test, windows))]
+mod dependency_consolidation_tests {
+    use super::*;
+    use std::os::windows::fs::OpenOptionsExt;
+
+    #[test]
+    fn library_search_excludes_outputs_and_preserves_dependencies() {
+        let root = std::env::temp_dir().join(format!(
+            "rules-rust-dependency-test-{}-{}",
+            std::process::id(),
+            SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos(),
+        ));
+        fs::create_dir(&root).unwrap();
+        let _root_cleanup = TemporaryDirectoryGuard::new(Some(root.clone()));
+        let first = root.join("first");
+        let second = root.join("second");
+        fs::create_dir(&first).unwrap();
+        fs::create_dir(&second).unwrap();
+        let libraries = ["libdep.rlib", "libdep.rmeta", "macro.dll", "macro.dll.lib", "native.LIB", "libnative.a"];
+        for name in libraries {
+            fs::write(first.join(name), name).unwrap();
+        }
+        fs::write(second.join("libdep.rlib"), "later duplicate must not replace first").unwrap();
+        for name in ["test.exe", "test.exe.tmp1", "test.rcgu.o", "test.params", "test.d", "scratch.tmp.rlib"] {
+            fs::write(first.join(name), "not a dependency").unwrap();
+        }
+        // A sibling link action may hold its PDB exclusively while this action
+        // starts. Dependency setup must not attempt to link/copy that file.
+        let pdb = OpenOptions::new().write(true).create_new(true).share_mode(0)
+            .open(first.join("other-test.pdb")).unwrap();
+        // rustc writes its archive beside the final library under this name.
+        // A concurrent consumer must ignore it even though it ends in `.a`.
+        let archive = OpenOptions::new().write(true).create_new(true).share_mode(0)
+            .open(first.join("core-unit-tests-bin.lib.temp-archive-b55baa9.a")).unwrap();
+        for i in 0..200 {
+            fs::write(first.join(format!("other-{i}.pdb")), "unrelated symbols").unwrap();
+        }
+        let args = vec![
+            "--crate-name=consumer".to_owned(),
+            format!("-Ldependency={}", first.display()),
+            "-L".to_owned(), format!("dependency={}", second.display()),
+            format!("-Ldependency={}", first.display()),
+            "-Lnative=preserved-native-path".to_owned(),
+        ];
+        let (actual, directory) = consolidate_dependency_search_paths(&args).unwrap();
+        let directory = directory.unwrap();
+        let cleanup = TemporaryDirectoryGuard::new(Some(directory.clone()));
+        assert_eq!(&actual[..2], ["--crate-name=consumer", "-Lnative=preserved-native-path"]);
+        assert_eq!(actual.len(), 3);
+        let found: HashSet<_> = fs::read_dir(&directory).unwrap()
+            .map(|entry| entry.unwrap().file_name().to_string_lossy().into_owned()).collect();
+        assert_eq!(found, libraries.iter().map(|name| (*name).to_owned()).collect());
+        assert_eq!(fs::read_to_string(directory.join("libdep.rlib")).unwrap(), "libdep.rlib");
+        drop(cleanup);
+        assert!(!directory.exists());
+        drop(pdb);
+        drop(archive);
+
+        let temporary_dirs = || -> HashSet<PathBuf> {
+            let prefix = format!("rules_rust_process_wrapper_deps_{}_", std::process::id());
+            fs::read_dir(std::env::current_dir().unwrap()).unwrap()
+                .filter_map(Result::ok)
+                .filter(|entry| entry.file_name().to_string_lossy().starts_with(&prefix))
+                .map(|entry| entry.path()).collect()
+        };
+        let before = temporary_dirs();
+        assert!(consolidate_dependency_search_paths(&[
+            format!("-Ldependency={}", first.display()),
+            format!("-Ldependency={}", root.join("missing-required-directory").display()),
+        ]).is_err());
+        assert_eq!(temporary_dirs(), before, "failed setup leaked its temporary directory");
+    }
+}

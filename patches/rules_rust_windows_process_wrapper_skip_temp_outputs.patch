+fn is_dependency_library(name: &str) -> bool {
+    // -Ldependency contains Rust libraries and metadata, not neighboring test
+    // executables, PDBs, response files, or outputs another action is replacing.
+    // Keep native/import libraries alongside Rust dynamic libraries as well.
+    !name.contains(".tmp")
+        && !name.contains(".temp-archive-")
+        && [".rlib", ".rmeta", ".dll", ".lib", ".a", ".so", ".dylib"]
+            .iter()
+            .any(|extension| name.ends_with(extension))
+}

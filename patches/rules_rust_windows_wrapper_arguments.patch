+#[cfg(test)]
+mod wrapper_response_tests {
+    use super::{expand_wrapper_args, OptionError};
+
+    #[test]
+    fn expands_only_wrapper_arguments_without_shell_unescaping() {
+        let args = ["wrapper", "--wrapper-args-file=wrapper params", "--", "rustc", "@rustc.params", "--wrapper-args-file=literal"]
+            .map(str::to_owned).to_vec();
+        let actual = expand_wrapper_args(args, &mut |path| {
+            assert_eq!(path, "wrapper params");
+            Ok("--arg-file\r\nC:\\build dir\\flags\r\n--subst\r\nroot=C:\\build dir\\\r\n\r\n".to_owned())
+        }).unwrap();
+        assert_eq!(actual, ["wrapper", "--arg-file", "C:\\build dir\\flags", "--subst", "root=C:\\build dir\\", "", "--", "rustc", "@rustc.params", "--wrapper-args-file=literal"]);
+    }
+
+    #[test]
+    fn preserves_existing_invocations() {
+        let args = ["wrapper", "--arg-file", "flags", "--", "rustc", "@args"].map(str::to_owned).to_vec();
+        let expected = args.clone();
+        let actual = expand_wrapper_args(args, &mut |_| panic!("no response file expected")).unwrap();
+        assert_eq!(actual, expected);
+    }
+
+    #[test]
+    fn fails_when_wrapper_response_file_is_unreadable() {
+        let args = ["wrapper", "--wrapper-args-file=missing", "--", "rustc"].map(str::to_owned).to_vec();
+        assert!(expand_wrapper_args(args, &mut |_| Err(OptionError::Generic("missing".to_owned()))).is_err());
+    }
+}

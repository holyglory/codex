+// Only the wrapper prefix uses this response-file protocol. In particular,
+// do not consume rustc's @files or anything after its -- separator.
+fn expand_wrapper_args(
+    args: Vec<String>,
+    read: &mut impl FnMut(&str) -> Result<String, OptionError>,
+) -> Result<Vec<String>, OptionError> {
+    let mut expanded = Vec::new();
+    let mut child = false;
+    for (index, argument) in args.into_iter().enumerate() {
+        if index != 0 && !child {
+            if let Some(path) = argument.strip_prefix("--wrapper-args-file=") {
+                // Bazel's multiline format has one literal argument per line.
+                // Preserve spaces, empty arguments and trailing backslashes.
+                expanded.extend(read(path)?.lines().map(str::to_owned));
+                continue;
+            }
+            child = argument == "--";
+        }
+        expanded.push(argument);
+    }
+    Ok(expanded)
+}
